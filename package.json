{
  "name": "sistema-pizzeria",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de gestión para pizzería",
  "author": "Chanw",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "rebuild:nativos": "electron-rebuild -f -w better-sqlite3",
    "icono:win": "powershell -NoProfile -ExecutionPolicy Bypass -File build/installer/generar-icono.ps1",
    "dist:win": "npm run icono:win && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "local.pizzeria.gestion",
  "productName": "Pizzeria Wili",
  "executableName": "PizzeriaWili",
  "artifactName": "Pizzeria-Wili-Setup-${version}.${ext}",
  "icon": "build/installer/icon.ico",
    "directories": {
      "output": "distribucion"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/installer/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installer/icon.ico",
      "uninstallerIcon": "build/installer/icon.ico",
      "installerHeaderIcon": "build/installer/icon.ico",
      "installerLanguages": ["es_ES"],
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pizzeria Wili"
    }
  },
  "main": "out/main/index.js"
}
